<%- include('../partials/layout-open') %>

<div class="flex">
  <%- include('../partials/admin-sidebar') %>
  <div class="flex-1 p-4 md:p-8 space-y-8">

    <!-- Header -->
    <div class="flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-brand-400 mb-1">Admin Panel</p>
        <h1 class="font-display text-2xl font-bold text-white">Users & Links</h1>
      </div>
      <div class="flex items-center gap-3 text-xs">
        <span class="px-2 py-1 rounded-full bg-slate-500/15 text-slate-300">user</span>
        <span class="px-2 py-1 rounded-full bg-brand-500/15 text-brand-300">admin</span>
      </div>
    </div>

    <!-- Stats bar -->
    <div class="grid grid-cols-3 gap-4">
      <div class="glass rounded-2xl border border-white/10 p-5 text-center">
        <p class="text-3xl font-extrabold text-white"><%= users.length %></p>
        <p class="text-xs text-slate-400 mt-1">Total Users</p>
      </div>
      <div class="glass rounded-2xl border border-white/10 p-5 text-center">
        <p class="text-3xl font-extrabold text-brand-400"><%= totalAdmins %></p>
        <p class="text-xs text-slate-400 mt-1">Admins</p>
      </div>
      <div class="glass rounded-2xl border border-white/10 p-5 text-center">
        <p class="text-3xl font-extrabold text-sky-400"><%= totalLinks %></p>
        <p class="text-xs text-slate-400 mt-1">Uploaded Links</p>
      </div>
    </div>

    <!-- User cards -->
    <div class="space-y-4">
      <% users.forEach(function(u, i) { %>
        <div class="glass rounded-2xl border border-white/10 overflow-hidden">

          <!-- Card header -->
          <div class="flex items-center gap-4 p-5 cursor-pointer select-none" onclick="toggleCard('card-<%= u._id %>')">
            <!-- Avatar -->
            <div class="grid place-items-center w-11 h-11 rounded-full bg-gradient-to-br from-brand-500 to-red-700 text-white font-bold text-lg shrink-0">
              <%= u.name.charAt(0).toUpperCase() %>
            </div>

            <!-- Info -->
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="text-white font-semibold"><%= u.name %></span>
                <span class="text-xs px-2 py-0.5 rounded-full <%= u.role === 'admin' ? 'bg-brand-500/20 text-brand-300' : 'bg-slate-500/20 text-slate-300' %>"><%= u.role %></span>
              </div>
              <p class="text-sm text-slate-400 truncate"><%= u.email %></p>
            </div>

            <!-- Meta -->
            <div class="hidden md:flex items-center gap-6 text-xs text-slate-500 shrink-0">
              <div class="text-center">
                <p class="text-white font-semibold text-sm"><%= u.uploadedLinks ? u.uploadedLinks.length : 0 %></p>
                <p>Links</p>
              </div>
              <div class="text-center">
                <p class="text-white font-semibold text-sm"><%= u.createdAt ? u.createdAt.toISOString().slice(0,10) : '—' %></p>
                <p>Joined</p>
              </div>
            </div>

            <!-- Chevron -->
            <svg id="chevron-<%= u._id %>" class="w-4 h-4 text-slate-400 shrink-0 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
          </div>

          <!-- Expandable body -->
          <div id="card-<%= u._id %>" class="hidden border-t border-white/5">
            <div class="p-5 space-y-5">

              <!-- Details grid -->
              <div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-xs">
                <div class="bg-white/5 rounded-xl p-3">
                  <p class="text-slate-500 mb-1">User ID</p>
                  <p class="text-slate-300 font-mono break-all"><%= u._id %></p>
                </div>
                <div class="bg-white/5 rounded-xl p-3">
                  <p class="text-slate-500 mb-1">Email</p>
                  <p class="text-slate-300 break-all"><%= u.email %></p>
                </div>
                <div class="bg-white/5 rounded-xl p-3">
                  <p class="text-slate-500 mb-1">Role</p>
                  <span class="px-2 py-0.5 rounded-full <%= u.role === 'admin' ? 'bg-brand-500/20 text-brand-300' : 'bg-slate-500/20 text-slate-300' %>"><%= u.role %></span>
                </div>
                <div class="bg-white/5 rounded-xl p-3">
                  <p class="text-slate-500 mb-1">Joined</p>
                  <p class="text-slate-300"><%= u.createdAt ? u.createdAt.toISOString().slice(0,10) : '—' %></p>
                </div>
              </div>

              <!-- Role toggle switch -->
              <div class="flex items-center gap-3">
                <span class="text-xs text-slate-400">Role:</span>
                <form action="/admin/users/<%= u._id %>/role" method="post" id="role-form-<%= u._id %>">
                  <label class="role-switch" title="<%= u.role === 'admin' ? 'Demote to User' : 'Promote to Admin' %>">
                    <input
                      type="checkbox"
                      <%= u.role === 'admin' ? 'checked' : '' %>
                      onchange="document.getElementById('role-form-<%= u._id %>').submit()"
                    />
                    <span class="role-switch__label-off">User</span>
                    <span class="role-switch__track">
                      <span class="role-switch__thumb"></span>
                    </span>
                    <span class="role-switch__label-on">Admin</span>
                  </label>
                </form>
              </div>

              <!-- Uploaded links -->
              <div>
                <div class="flex items-center justify-between mb-3">
                  <p class="text-sm font-semibold text-white">Uploaded Links <span class="text-slate-500 font-normal">(<%= u.uploadedLinks ? u.uploadedLinks.length : 0 %>)</span></p>
                </div>

                <% if (u.uploadedLinks && u.uploadedLinks.length) { %>
                  <div class="rounded-xl border border-white/10 overflow-hidden mb-4">
                    <table class="w-full text-xs">
                      <thead class="text-slate-500 text-left border-b border-white/5 bg-white/3">
                        <tr>
                          <th class="px-3 py-2">#</th>
                          <th class="px-3 py-2">Label</th>
                          <th class="px-3 py-2">URL</th>
                          <th class="px-3 py-2">Added</th>
                          <th class="px-3 py-2 text-right">Action</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% u.uploadedLinks.forEach(function(lnk, idx) { %>
                          <tr class="border-b border-white/5 hover:bg-white/5">
                            <td class="px-3 py-2 text-slate-500"><%= idx + 1 %></td>
                            <td class="px-3 py-2 text-slate-300"><%= lnk.label || '—' %></td>
                            <td class="px-3 py-2 max-w-xs">
                              <a href="<%= lnk.url %>" target="_blank" rel="noopener" class="text-sky-400 hover:text-sky-300 truncate block max-w-[220px]"><%= lnk.url %></a>
                            </td>
                            <td class="px-3 py-2 text-slate-500"><%= lnk.addedAt ? lnk.addedAt.toISOString().slice(0,10) : '—' %></td>
                            <td class="px-3 py-2 text-right">
                              <form action="/admin/users/<%= u._id %>/links/<%= idx %>/delete" method="post" onsubmit="return confirm('Remove this link?')">
                                <button class="text-red-400 hover:text-red-300 transition-colors">✕ Remove</button>
                              </form>
                            </td>
                          </tr>
                        <% }); %>
                      </tbody>
                    </table>
                  </div>
                <% } else { %>
                  <p class="text-xs text-slate-500 mb-4">No links uploaded yet.</p>
                <% } %>

                <!-- Add link form -->
                <form action="/admin/users/<%= u._id %>/links" method="post" class="flex flex-col sm:flex-row gap-2">
                  <input name="label" class="input flex-1 !py-2 !text-xs" placeholder="Label (optional)" />
                  <input name="url" required class="input flex-[2] !py-2 !text-xs" placeholder="https://example.com/link" />
                  <button class="btn-primary !py-2 !px-4 !text-xs shrink-0">＋ Add Link</button>
                </form>
              </div>

            </div>
          </div>
        </div>
      <% }); %>
    </div>

    <!-- Summary table -->
    <div>
      <h2 class="font-display text-lg font-semibold text-white mb-4">All Users Summary</h2>
      <div class="glass rounded-2xl border border-white/10 overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="text-slate-400 text-left border-b border-white/5">
            <tr>
              <th class="p-3">#</th>
              <th class="p-3">Name</th>
              <th class="p-3">Email</th>
              <th class="p-3">Role</th>
              <th class="p-3 text-center">Links</th>
              <th class="p-3">Joined</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(function(u, i) { %>
              <tr class="border-b border-white/5 hover:bg-white/5 cursor-pointer" onclick="toggleCard('card-<%= u._id %>'); this.closest('.space-y-8').querySelector('#card-<%= u._id %>').scrollIntoView({behavior:'smooth', block:'center'})">
                <td class="p-3 text-slate-500"><%= i + 1 %></td>
                <td class="p-3">
                  <div class="flex items-center gap-2">
                    <div class="grid place-items-center w-7 h-7 rounded-full bg-gradient-to-br from-brand-500 to-red-700 text-white text-xs font-bold shrink-0"><%= u.name.charAt(0).toUpperCase() %></div>
                    <span class="text-white"><%= u.name %></span>
                  </div>
                </td>
                <td class="p-3 text-slate-400"><%= u.email %></td>
                <td class="p-3">
                  <span class="text-xs px-2 py-0.5 rounded-full <%= u.role === 'admin' ? 'bg-brand-500/15 text-brand-300' : 'bg-slate-500/15 text-slate-300' %>"><%= u.role %></span>
                </td>
                <td class="p-3 text-center">
                  <span class="text-xs px-2 py-0.5 rounded-full <%= (u.uploadedLinks && u.uploadedLinks.length) ? 'bg-sky-500/15 text-sky-300' : 'bg-white/5 text-slate-500' %>">
                    <%= u.uploadedLinks ? u.uploadedLinks.length : 0 %>
                  </span>
                </td>
                <td class="p-3 text-slate-400"><%= u.createdAt ? u.createdAt.toISOString().slice(0,10) : '—' %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

  </div>
</div>

<script>
  function toggleCard(id) {
    const body = document.getElementById(id);
    const chevron = document.getElementById('chevron-' + id.replace('card-', ''));
    const isOpen = !body.classList.contains('hidden');
    body.classList.toggle('hidden', isOpen);
    if (chevron) chevron.style.transform = isOpen ? '' : 'rotate(180deg)';
  }
</script>

<%- include('../partials/layout-close') %>
