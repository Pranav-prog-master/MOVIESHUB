<%- include('../partials/layout-open') %>

<div class="flex">
  <%- include('../partials/admin-sidebar') %>
  <div class="flex-1 p-4 md:p-8">
    <h1 class="font-display text-2xl font-bold text-white mb-6">Uploaded Posters</h1>

    <% if (files && files.length) { %>
      <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 gap-4">
        <% files.forEach(function (f) { %>
          <div class="glass rounded-xl overflow-hidden border border-white/10">
            <img src="/uploads/posters/<%= f %>" class="w-full aspect-[2/3] object-cover" />
            <p class="text-[11px] text-slate-400 p-2 truncate"><%= f %></p>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <p class="text-slate-400">No posters uploaded yet. Add a movie with a poster image.</p>
    <% } %>
  </div>
</div>

<%- include('../partials/layout-close') %>

