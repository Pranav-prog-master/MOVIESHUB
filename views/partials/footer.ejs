<footer class="border-t" style="border-color:var(--border);background:var(--bg-2)">
  <div class="max-w-7xl mx-auto px-4 py-10 grid gap-8 md:grid-cols-4">
    <div>
      <div class="flex items-center gap-2 mb-3">
        <span class="grid place-items-center w-8 h-8 rounded-lg bg-gradient-to-br from-brand-500 to-red-700">
          <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm6 4v8l6-4-6-4z"/></svg>
        </span>
        <span class="font-display font-extrabold" style="color:var(--text)">XP <span style="color:var(--brand)">Movies</span></span>
      </div>
      <p class="text-sm" style="color:var(--muted)">Discover movies and where to watch them legally. We only link to authorized streaming, rental and purchase sources.</p>
    </div>
    <div>
      <h4 class="font-semibold mb-3" style="color:var(--text)">Explore</h4>
      <ul class="space-y-2 text-sm" style="color:var(--muted)">
        <li><a href="/category/hollywood" class="hover-text transition-colors">Hollywood</a></li>
        <li><a href="/category/bollywood" class="hover-text transition-colors">Bollywood</a></li>
        <li><a href="/category/south" class="hover-text transition-colors">South</a></li>
        <li><a href="/category/anime" class="hover-text transition-colors">Anime</a></li>
        <li><a href="/category/cartoon" class="hover-text transition-colors">Cartoon</a></li>
      </ul>
    </div>
    <div>
      <h4 class="font-semibold mb-3" style="color:var(--text)">Legal</h4>
      <ul class="space-y-2 text-sm" style="color:var(--muted)">
        <li><a href="/discover" class="hover-text transition-colors">Discover</a></li>
        <li><span class="opacity-60">No pirated content</span></li>
        <li><span class="opacity-60">Official sources only</span></li>
      </ul>
    </div>
    <div>
      <h4 class="font-semibold mb-3" style="color:var(--text)">Account</h4>
      <ul class="space-y-2 text-sm" style="color:var(--muted)">
        <li><a href="/login" class="hover-text transition-colors">Login</a></li>
        <li><a href="/register" class="hover-text transition-colors">Register</a></li>
        <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %><li><a href="/admin" class="hover-text transition-colors">Admin</a></li><% } %>
      </ul>
    </div>
  </div>
  <div class="text-center text-xs py-5 border-t" style="color:var(--muted);border-color:var(--border)">
    © <%= new Date().getFullYear() %> XP Movies. For demonstration only. All viewing/download links point to authorized providers.
  </div>
</footer>
