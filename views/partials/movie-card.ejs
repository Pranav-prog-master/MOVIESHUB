<%
  var m = typeof movie !== 'undefined' ? movie : {};
  var isExternal = m.external === true;
  var href = isExternal ? '#' : ('/movie/' + (m.slug || m._id));
  var year = m.releaseYear || m.year || '';
  var category = m.category || '';
  var rating = m.rating || 0;
  var poster = m.poster || '/images/placeholder.svg';
%>
<div class="movie-card group relative rounded-2xl overflow-hidden glass">
  <a href="<%= href %>" class="block relative aspect-[2/3] overflow-hidden">
    <img src="<%= poster %>" alt="<%= m.title || 'Movie' %>" loading="lazy"
      class="w-full h-full object-cover transition duration-500 group-hover:scale-110"
      onerror="this.src='/images/placeholder.svg'" />
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent opacity-0 group-hover:opacity-100 transition"></div>

    <% if (rating) { %>
      <span class="absolute top-2 left-2 flex items-center gap-1 text-[11px] font-semibold bg-black/70 text-amber-300 px-2 py-1 rounded-full">
        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3 6.5 7 .9-5 4.8 1.3 7-6.3-3.4L5.7 21l1.3-7-5-4.8 7-.9z"/></svg>
        <%= rating.toFixed(1) %>
      </span>
    <% } %>

    <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition">
      <span class="grid place-items-center w-14 h-14 rounded-full bg-brand-500/90 shadow-lg shadow-brand-500/40 text-white">
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
      </span>
    </div>
  </a>

  <div class="p-3">
    <h3 class="font-display font-semibold text-sm leading-tight truncate" style="color:var(--text)"><%= m.title || 'Untitled' %></h3>
    <div class="flex items-center justify-between mt-1 text-xs" style="color:var(--muted)">
      <span><%= year %></span>
      <% if (category) { %><span class="truncate max-w-[60%]"><%= category %></span><% } %>
    </div>
    <div class="mt-3 flex gap-2 opacity-0 group-hover:opacity-100 transition">
      <a href="<%= href %>" class="btn-primary flex-1 !py-1.5 !text-xs text-center">Details</a>
      <% if (m.watchUrl) { %>
        <% if (typeof user !== 'undefined' && user) { %>
          <a href="<%= m.watchUrl %>" target="_blank" rel="noopener noreferrer" class="btn-ghost flex-1 !py-1.5 !text-xs text-center">Watch</a>
        <% } else { %>
          <a href="/login" class="btn-ghost flex-1 !py-1.5 !text-xs text-center">🔒 Login</a>
        <% } %>
      <% } %>
    </div>
  </div>
</div>
