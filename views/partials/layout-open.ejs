<%- include('head') %>
  <body class="font-body antialiased min-h-screen" style="background:var(--bg);color:var(--text)">

    <!-- Flash / toast container -->
    <div id="toast-container" class="fixed top-4 right-4 z-[100] space-y-2"></div>

    <%- include('header') %>

    <main class="pb-24">
      <% if (typeof flash !== 'undefined' && flash) { %>
        <div class="max-w-7xl mx-auto px-4 mt-4">
          <div class="flash flash-<%= flash.type %> px-4 py-3 rounded-xl text-sm" role="alert">
            <%= flash.message %>
          </div>
        </div>
      <% } %>

