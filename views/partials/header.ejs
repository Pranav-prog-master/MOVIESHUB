<header class="sticky top-0 z-50 backdrop-blur-xl" style="background:rgba(10,10,15,0.75);border-bottom:1px solid rgba(255,255,255,0.06)">
  <nav class="max-w-7xl mx-auto px-4 h-16 flex items-center gap-4">

    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 shrink-0 mr-2">
      <span class="grid place-items-center w-8 h-8 rounded-lg bg-gradient-to-br from-brand-500 to-red-700 shadow-lg shadow-brand-500/30">
        <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm6 4v8l6-4-6-4z"/></svg>
      </span>
      <span class="font-display font-extrabold text-base tracking-tight hidden sm:block" style="color:var(--text)">XP <span style="color:var(--brand)">Movies</span></span>
    </a>

    <!-- Pill Nav (desktop) -->
    <div class="hidden md:flex flex-1 justify-center">
      <div class="flex items-center gap-0.5 px-1.5 py-1.5 rounded-full text-sm" style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.12)">

        <!-- Home (active pill) -->
        <a href="/" class="px-4 py-1.5 rounded-full font-semibold text-sm transition-all" style="background:#fff;color:#0a0a0f">Home</a>

        <!-- Genre dropdown -->
        <div class="relative group">
          <button class="flex items-center gap-1 px-4 py-1.5 rounded-full text-sm transition-colors hover:text-white" style="color:rgba(255,255,255,0.65)">
            Genre
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="absolute top-full left-1/2 -translate-x-1/2 mt-2 w-44 rounded-xl overflow-hidden opacity-0 group-hover:opacity-100 pointer-events-none group-hover:pointer-events-auto transition-all shadow-2xl z-50" style="background:rgba(18,18,28,0.97);border:1px solid rgba(255,255,255,0.1)">
            <a href="/genres" class="block px-4 py-2.5 text-sm transition-colors hover:text-white" style="color:rgba(255,255,255,0.65)" onmouseover="this.style.background='rgba(255,255,255,0.07)'" onmouseout="this.style.background='transparent'">All Genres</a>
            <a href="/movies?genre=action" class="block px-4 py-2.5 text-sm transition-colors hover:text-white" style="color:rgba(255,255,255,0.65)" onmouseover="this.style.background='rgba(255,255,255,0.07)'" onmouseout="this.style.background='transparent'">Action</a>
            <a href="/movies?genre=comedy" class="block px-4 py-2.5 text-sm transition-colors hover:text-white" style="color:rgba(255,255,255,0.65)" onmouseover="this.style.background='rgba(255,255,255,0.07)'" onmouseout="this.style.background='transparent'">Comedy</a>
            <a href="/movies?genre=drama" class="block px-4 py-2.5 text-sm transition-colors hover:text-white" style="color:rgba(255,255,255,0.65)" onmouseover="this.style.background='rgba(255,255,255,0.07)'" onmouseout="this.style.background='transparent'">Drama</a>
            <a href="/movies?genre=thriller" class="block px-4 py-2.5 text-sm transition-colors hover:text-white" style="color:rgba(255,255,255,0.65)" onmouseover="this.style.background='rgba(255,255,255,0.07)'" onmouseout="this.style.background='transparent'">Thriller</a>
            <a href="/movies?genre=horror" class="block px-4 py-2.5 text-sm transition-colors hover:text-white" style="color:rgba(255,255,255,0.65)" onmouseover="this.style.background='rgba(255,255,255,0.07)'" onmouseout="this.style.background='transparent'">Horror</a>
          </div>
        </div>

        <!-- Category dropdown -->
        <div class="relative group">
          <button class="flex items-center gap-1 px-4 py-1.5 rounded-full text-sm transition-colors hover:text-white" style="color:rgba(255,255,255,0.65)">
            Category
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="absolute top-full left-1/2 -translate-x-1/2 mt-2 w-44 rounded-xl overflow-hidden opacity-0 group-hover:opacity-100 pointer-events-none group-hover:pointer-events-auto transition-all shadow-2xl z-50" style="background:rgba(18,18,28,0.97);border:1px solid rgba(255,255,255,0.1)">
            <a href="/category/hollywood" class="block px-4 py-2.5 text-sm" style="color:rgba(255,255,255,0.65)" onmouseover="this.style.background='rgba(255,255,255,0.07)'" onmouseout="this.style.background='transparent'">Hollywood</a>
            <a href="/category/bollywood" class="block px-4 py-2.5 text-sm" style="color:rgba(255,255,255,0.65)" onmouseover="this.style.background='rgba(255,255,255,0.07)'" onmouseout="this.style.background='transparent'">Bollywood</a>
            <a href="/category/south" class="block px-4 py-2.5 text-sm" style="color:rgba(255,255,255,0.65)" onmouseover="this.style.background='rgba(255,255,255,0.07)'" onmouseout="this.style.background='transparent'">South</a>
            <a href="/category/anime" class="block px-4 py-2.5 text-sm" style="color:rgba(255,255,255,0.65)" onmouseover="this.style.background='rgba(255,255,255,0.07)'" onmouseout="this.style.background='transparent'">Anime</a>
            <a href="/category/cartoon" class="block px-4 py-2.5 text-sm" style="color:rgba(255,255,255,0.65)" onmouseover="this.style.background='rgba(255,255,255,0.07)'" onmouseout="this.style.background='transparent'">Cartoon</a>
          </div>
        </div>

        <!-- OTT dropdown -->
        <div class="relative group">
          <button class="flex items-center gap-1 px-4 py-1.5 rounded-full text-sm transition-colors hover:text-white" style="color:rgba(255,255,255,0.65)">
            OTT
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="absolute top-full left-1/2 -translate-x-1/2 mt-2 w-44 rounded-xl overflow-hidden opacity-0 group-hover:opacity-100 pointer-events-none group-hover:pointer-events-auto transition-all shadow-2xl z-50" style="background:rgba(18,18,28,0.97);border:1px solid rgba(255,255,255,0.1)">
            <a href="/movies?ott=netflix" class="block px-4 py-2.5 text-sm" style="color:rgba(255,255,255,0.65)" onmouseover="this.style.background='rgba(255,255,255,0.07)'" onmouseout="this.style.background='transparent'">Netflix</a>
            <a href="/movies?ott=prime" class="block px-4 py-2.5 text-sm" style="color:rgba(255,255,255,0.65)" onmouseover="this.style.background='rgba(255,255,255,0.07)'" onmouseout="this.style.background='transparent'">Prime Video</a>
            <a href="/movies?ott=hotstar" class="block px-4 py-2.5 text-sm" style="color:rgba(255,255,255,0.65)" onmouseover="this.style.background='rgba(255,255,255,0.07)'" onmouseout="this.style.background='transparent'">Hotstar</a>
            <a href="/movies?ott=apple" class="block px-4 py-2.5 text-sm" style="color:rgba(255,255,255,0.65)" onmouseover="this.style.background='rgba(255,255,255,0.07)'" onmouseout="this.style.background='transparent'">Apple TV+</a>
          </div>
        </div>

        <!-- Movies link -->
        <a href="/movies" class="flex items-center gap-1 px-4 py-1.5 rounded-full text-sm transition-colors hover:text-white" style="color:rgba(255,255,255,0.65)">
          Movies
        </a>

        <!-- Collection dropdown -->
        <div class="relative group">
          <button class="flex items-center gap-1 px-4 py-1.5 rounded-full text-sm transition-colors hover:text-white" style="color:rgba(255,255,255,0.65)">
            Collection
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="absolute top-full left-1/2 -translate-x-1/2 mt-2 w-44 rounded-xl overflow-hidden opacity-0 group-hover:opacity-100 pointer-events-none group-hover:pointer-events-auto transition-all shadow-2xl z-50" style="background:rgba(18,18,28,0.97);border:1px solid rgba(255,255,255,0.1)">
            <a href="/movies?sort=rating" class="block px-4 py-2.5 text-sm" style="color:rgba(255,255,255,0.65)" onmouseover="this.style.background='rgba(255,255,255,0.07)'" onmouseout="this.style.background='transparent'">Top Rated</a>
            <a href="/movies?sort=year" class="block px-4 py-2.5 text-sm" style="color:rgba(255,255,255,0.65)" onmouseover="this.style.background='rgba(255,255,255,0.07)'" onmouseout="this.style.background='transparent'">Latest</a>
            <a href="/movies?sort=popularity" class="block px-4 py-2.5 text-sm" style="color:rgba(255,255,255,0.65)" onmouseover="this.style.background='rgba(255,255,255,0.07)'" onmouseout="this.style.background='transparent'">Popular</a>
          </div>
        </div>

        <!-- Discover -->
        <a href="/discover" class="flex items-center gap-1 px-4 py-1.5 rounded-full text-sm transition-colors hover:text-white" style="color:rgba(255,255,255,0.65)">
          Discover
        </a>

      </div>
    </div>

    <!-- Right icons -->
    <div class="flex items-center gap-1 ml-auto md:ml-0">

      <!-- Search icon (desktop) -->
      <button onclick="document.getElementById('search-overlay').classList.toggle('hidden')" class="hidden md:grid place-items-center w-9 h-9 rounded-full transition-colors hover:text-white" style="color:rgba(255,255,255,0.6)" title="Search">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      </button>

      <!-- User / Filter icon -->
      <% if (typeof user !== 'undefined' && user) { %>
        <div class="relative group">
          <button class="hidden md:grid place-items-center w-9 h-9 rounded-full transition-colors hover:text-white" style="color:rgba(255,255,255,0.6)" title="Account">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="6" x2="20" y2="6"/><line x1="8" y1="12" x2="20" y2="12"/><line x1="12" y1="18" x2="20" y2="18"/></svg>
          </button>
          <div class="absolute right-0 mt-2 w-52 rounded-xl overflow-hidden opacity-0 group-hover:opacity-100 pointer-events-none group-hover:pointer-events-auto transition-all shadow-2xl z-50" style="background:rgba(18,18,28,0.97);border:1px solid rgba(255,255,255,0.1)">
            <div class="px-4 py-2.5 border-b flex items-center gap-2" style="border-color:rgba(255,255,255,0.08)">
              <span class="text-xs px-2 py-0.5 rounded-full" style="background:rgba(239,68,68,0.15);color:var(--brand)"><%= user.role %></span>
              <span class="text-xs truncate" style="color:rgba(255,255,255,0.4)"><%= user.email %></span>
            </div>
            <a href="/profile" class="flex items-center gap-2 px-4 py-2.5 text-sm" style="color:rgba(255,255,255,0.65)" onmouseover="this.style.background='rgba(255,255,255,0.07)'" onmouseout="this.style.background='transparent'">Profile</a>
            <% if (user.role === 'admin') { %>
              <a href="/admin" class="flex items-center gap-2 px-4 py-2.5 text-sm" style="color:var(--brand)" onmouseover="this.style.background='rgba(255,255,255,0.07)'" onmouseout="this.style.background='transparent'">Admin Dashboard</a>
            <% } %>
            <a href="/settings" class="flex items-center gap-2 px-4 py-2.5 text-sm" style="color:rgba(255,255,255,0.65)" onmouseover="this.style.background='rgba(255,255,255,0.07)'" onmouseout="this.style.background='transparent'">Settings</a>
            <a href="/logout" class="flex items-center gap-2 px-4 py-2.5 text-sm" style="color:var(--brand)" onmouseover="this.style.background='rgba(255,255,255,0.07)'" onmouseout="this.style.background='transparent'">Logout</a>
          </div>
        </div>
      <% } else { %>
        <a href="/login" class="hidden md:inline-flex text-sm px-3 py-1.5 rounded-full transition-colors" style="color:rgba(255,255,255,0.6)">Login</a>
        <a href="/register" class="btn-primary !py-1.5 !px-4 text-sm">Register</a>
      <% } %>

      <!-- Mobile menu toggle -->
      <button onclick="document.getElementById('mobile-menu').classList.toggle('hidden')" class="md:hidden grid place-items-center w-9 h-9 rounded-full" style="color:rgba(255,255,255,0.7)">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
    </div>
  </nav>

  <!-- Search overlay (desktop) -->
  <div id="search-overlay" class="hidden border-t px-4 py-3" style="border-color:rgba(255,255,255,0.06);background:rgba(10,10,15,0.95)">
    <form action="/search" method="get" class="max-w-xl mx-auto flex items-center relative" onsubmit="document.getElementById('search-suggestions').classList.add('hidden')">
      <svg class="w-4 h-4 absolute left-3 pointer-events-none" style="color:rgba(255,255,255,0.4)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      <input id="search-input" name="q" type="search" autocomplete="off" placeholder="Search movie titles…" autofocus
        class="w-full rounded-full pl-9 pr-3 py-2 text-sm focus:outline-none focus:ring-2"
        style="background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.12);color:var(--text);--tw-ring-color:var(--brand-glow)" />
      <div id="search-suggestions" class="hidden absolute top-12 left-0 right-0 glass rounded-xl overflow-hidden z-50 shadow-xl"></div>
    </form>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t px-4 py-3 space-y-1" style="border-color:rgba(255,255,255,0.06);background:rgba(10,10,15,0.97)">
    <form action="/search" method="get" class="flex items-center relative mb-3">
      <svg class="w-4 h-4 absolute left-3 pointer-events-none" style="color:rgba(255,255,255,0.4)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      <input name="q" type="search" placeholder="Search…" class="w-full rounded-full pl-9 pr-3 py-2 text-sm focus:outline-none" style="background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.12);color:var(--text)" />
    </form>
    <a href="/" class="block px-3 py-2 rounded-lg text-sm" style="color:rgba(255,255,255,0.7)" onmouseover="this.style.background='rgba(255,255,255,0.07)'" onmouseout="this.style.background='transparent'">Home</a>
    <a href="/genres" class="block px-3 py-2 rounded-lg text-sm" style="color:rgba(255,255,255,0.7)" onmouseover="this.style.background='rgba(255,255,255,0.07)'" onmouseout="this.style.background='transparent'">Genre</a>
    <a href="/category/hollywood" class="block px-3 py-2 rounded-lg text-sm" style="color:rgba(255,255,255,0.7)" onmouseover="this.style.background='rgba(255,255,255,0.07)'" onmouseout="this.style.background='transparent'">Hollywood</a>
    <a href="/category/bollywood" class="block px-3 py-2 rounded-lg text-sm" style="color:rgba(255,255,255,0.7)" onmouseover="this.style.background='rgba(255,255,255,0.07)'" onmouseout="this.style.background='transparent'">Bollywood</a>
    <a href="/category/south" class="block px-3 py-2 rounded-lg text-sm" style="color:rgba(255,255,255,0.7)" onmouseover="this.style.background='rgba(255,255,255,0.07)'" onmouseout="this.style.background='transparent'">South</a>
    <a href="/category/anime" class="block px-3 py-2 rounded-lg text-sm" style="color:rgba(255,255,255,0.7)" onmouseover="this.style.background='rgba(255,255,255,0.07)'" onmouseout="this.style.background='transparent'">Anime</a>
    <a href="/category/cartoon" class="block px-3 py-2 rounded-lg text-sm" style="color:rgba(255,255,255,0.7)" onmouseover="this.style.background='rgba(255,255,255,0.07)'" onmouseout="this.style.background='transparent'">Cartoon</a>
    <a href="/movies" class="block px-3 py-2 rounded-lg text-sm" style="color:rgba(255,255,255,0.7)" onmouseover="this.style.background='rgba(255,255,255,0.07)'" onmouseout="this.style.background='transparent'">Movies</a>
    <a href="/discover" class="block px-3 py-2 rounded-lg text-sm" style="color:rgba(255,255,255,0.7)" onmouseover="this.style.background='rgba(255,255,255,0.07)'" onmouseout="this.style.background='transparent'">Discover</a>
    <% if (!(typeof user !== 'undefined' && user)) { %>
      <a href="/login" class="block px-3 py-2 rounded-lg text-sm" style="color:rgba(255,255,255,0.7)" onmouseover="this.style.background='rgba(255,255,255,0.07)'" onmouseout="this.style.background='transparent'">Login</a>
      <a href="/register" class="block px-3 py-2 rounded-lg text-sm font-medium" style="color:var(--brand)">Register</a>
    <% } else { %>
      <a href="/profile" class="block px-3 py-2 rounded-lg text-sm" style="color:rgba(255,255,255,0.7)" onmouseover="this.style.background='rgba(255,255,255,0.07)'" onmouseout="this.style.background='transparent'">Profile</a>
      <a href="/logout" class="block px-3 py-2 rounded-lg text-sm" style="color:var(--brand)">Logout</a>
    <% } %>
  </div>
</header>
