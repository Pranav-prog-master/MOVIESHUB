<%- include('partials/layout-open') %>

<section class="max-w-7xl mx-auto px-4 pt-10 pb-16">

  <h1 class="font-display text-3xl md:text-4xl font-extrabold mb-6" style="color:var(--text)">Search Movies</h1>

  <form action="/search" method="get" class="relative max-w-2xl">
    <svg class="w-5 h-5 absolute left-4 top-3.5 pointer-events-none" style="color:var(--muted)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
    <input id="search-input" name="q" value="<%= q %>" autocomplete="off" placeholder="Search movie titles…"
      class="input !pl-11 !py-3 w-full text-base" />
    <div id="search-suggestions" class="hidden absolute top-14 left-0 right-0 glass rounded-xl overflow-hidden z-50"></div>
  </form>

  <% if (!q) { %>
    <p class="mt-6" style="color:var(--muted)">Type a query above to find movies in the library.</p>

  <% } else if (movies && movies.length) { %>
    <p class="text-sm mt-6" style="color:var(--muted)">
      <%= movies.length %> result(s) for "<span style="color:var(--text);font-weight:600"><%= q %></span>"
    </p>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4 mt-4">
      <% movies.forEach(function (m) { %><%- include('partials/movie-card', { movie: m }) %><% }); %>
    </div>

  <% } else { %>
    <div class="glass rounded-2xl p-12 text-center mt-6">
      <svg class="w-12 h-12 mx-auto mb-4" style="color:var(--muted)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      <p class="text-lg font-semibold" style="color:var(--text)">No results for "<%= q %>"</p>
      <p class="text-sm mt-1" style="color:var(--muted)">Try a different keyword or browse by category.</p>
      <div class="flex flex-wrap gap-3 justify-center mt-5">
        <a href="/movies" class="btn-ghost">Browse All Movies</a>
        <a href="/discover?q=<%= encodeURIComponent(q) %>" class="btn-primary">Discover Online</a>
      </div>
    </div>
  <% } %>

</section>

<%- include('partials/layout-close') %>
