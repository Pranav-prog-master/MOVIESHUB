<%- include('partials/layout-open') %>

<section class="max-w-7xl mx-auto px-4 pt-10">
  <h1 class="font-display text-3xl md:text-4xl font-extrabold text-white mb-2">Discover</h1>
  <p class="text-slate-400 mb-6">Search publicly available movie <span class="text-white">information</span>. Watch/download links point only to <span class="text-emerald-300">authorized</span> providers.</p>

  <form action="/discover" method="get" class="flex gap-3 max-w-2xl">
    <input name="q" value="<%= q %>" placeholder="Movie title…" class="input flex-1" />
    <button class="btn-primary">Search</button>
  </form>

  <% if (q) { %>
    <p class="text-xs text-slate-500 mt-3">Source: <%= source === 'tmdb' ? 'TMDB (external metadata)' : (source === 'local' ? 'Your XP Movies library' : 'none') %></p>

    <% if (results && results.length) { %>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4 mt-6">
        <% results.forEach(function (m) { %><%- include('partials/movie-card', { movie: m }) %><% }); %>
      </div>
    <% } else { %>
      <div class="glass rounded-2xl p-10 text-center mt-6">
        <p class="text-slate-300">No external information found for “<%= q %>”.</p>
      </div>
    <% } %>
  <% } %>
</section>

<%- include('partials/layout-close') %>

