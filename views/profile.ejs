<%- include('partials/layout-open') %>

<section class="max-w-2xl mx-auto px-4 pt-14 pb-16">

  <!-- Avatar + name -->
  <div class="flex flex-col items-center text-center mb-8">
    <div class="grid place-items-center w-24 h-24 rounded-3xl text-4xl font-extrabold font-display mb-4 shadow-lg"
      style="background:linear-gradient(135deg,var(--brand),var(--brand-2));color:#fff">
      <%= user.name.charAt(0).toUpperCase() %>
    </div>
    <h1 class="font-display text-3xl font-extrabold" style="color:var(--text)"><%= user.name %></h1>
    <p class="text-sm mt-1" style="color:var(--muted)"><%= user.email %></p>
    <span class="inline-block mt-2 text-xs font-semibold px-3 py-1 rounded-full"
      style="background:rgba(239,68,68,0.15);color:var(--brand)">
      <%= user.role.charAt(0).toUpperCase() + user.role.slice(1) %>
    </span>
  </div>

  <!-- Info card -->
  <div class="glass rounded-2xl p-6 mb-4">
    <p class="text-xs font-semibold tracking-widest uppercase mb-4" style="color:var(--brand)">Account Info</p>
    <div class="space-y-4">

      <div class="flex items-center justify-between py-3 border-b" style="border-color:var(--border)">
        <div class="flex items-center gap-3">
          <span class="grid place-items-center w-9 h-9 rounded-xl" style="background:var(--panel-hover)">
            <svg class="w-4 h-4" style="color:var(--brand)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
          </span>
          <div>
            <p class="text-xs" style="color:var(--muted)">Full Name</p>
            <p class="text-sm font-medium" style="color:var(--text)"><%= user.name %></p>
          </div>
        </div>
      </div>

      <div class="flex items-center justify-between py-3 border-b" style="border-color:var(--border)">
        <div class="flex items-center gap-3">
          <span class="grid place-items-center w-9 h-9 rounded-xl" style="background:var(--panel-hover)">
            <svg class="w-4 h-4" style="color:var(--brand)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </span>
          <div>
            <p class="text-xs" style="color:var(--muted)">Email</p>
            <p class="text-sm font-medium" style="color:var(--text)"><%= user.email %></p>
          </div>
        </div>
      </div>

      <div class="flex items-center justify-between py-3 border-b" style="border-color:var(--border)">
        <div class="flex items-center gap-3">
          <span class="grid place-items-center w-9 h-9 rounded-xl" style="background:var(--panel-hover)">
            <svg class="w-4 h-4" style="color:var(--brand)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3 7h7l-5.5 4 2 7L12 17l-6.5 3 2-7L2 9h7z"/></svg>
          </span>
          <div>
            <p class="text-xs" style="color:var(--muted)">Role</p>
            <p class="text-sm font-medium" style="color:var(--text)"><%= user.role.charAt(0).toUpperCase() + user.role.slice(1) %></p>
          </div>
        </div>
      </div>

      <div class="flex items-center justify-between py-3">
        <div class="flex items-center gap-3">
          <span class="grid place-items-center w-9 h-9 rounded-xl" style="background:var(--panel-hover)">
            <svg class="w-4 h-4" style="color:var(--brand)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
          </span>
          <div>
            <p class="text-xs" style="color:var(--muted)">Member Since</p>
            <p class="text-sm font-medium" style="color:var(--text)">
              <%= new Date(user.createdAt).toLocaleDateString('en-US', { year:'numeric', month:'long', day:'numeric' }) %>
            </p>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Quick actions -->
  <div class="grid grid-cols-2 gap-3">
    <a href="/settings" class="glass rounded-2xl p-4 flex items-center gap-3 transition-all" style="color:var(--text)"
      onmouseover="this.style.background='var(--panel-hover)'" onmouseout="this.style.background=''">
      <span class="grid place-items-center w-10 h-10 rounded-xl flex-shrink-0" style="background:rgba(239,68,68,0.12)">
        <svg class="w-5 h-5" style="color:var(--brand)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
      </span>
      <div>
        <p class="text-sm font-semibold" style="color:var(--text)">Settings</p>
        <p class="text-xs" style="color:var(--muted)">Edit profile & password</p>
      </div>
    </a>

    <% if (user.role === 'admin') { %>
      <a href="/admin" class="glass rounded-2xl p-4 flex items-center gap-3 transition-all" style="color:var(--text)"
        onmouseover="this.style.background='var(--panel-hover)'" onmouseout="this.style.background=''">
        <span class="grid place-items-center w-10 h-10 rounded-xl flex-shrink-0" style="background:rgba(239,68,68,0.12)">
          <svg class="w-5 h-5" style="color:var(--brand)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3 7h7l-5.5 4 2 7L12 17l-6.5 3 2-7L2 9h7z"/></svg>
        </span>
        <div>
          <p class="text-sm font-semibold" style="color:var(--text)">Admin</p>
          <p class="text-xs" style="color:var(--muted)">Manage movies & users</p>
        </div>
      </a>
    <% } else { %>
      <a href="/movies" class="glass rounded-2xl p-4 flex items-center gap-3 transition-all" style="color:var(--text)"
        onmouseover="this.style.background='var(--panel-hover)'" onmouseout="this.style.background=''">
        <span class="grid place-items-center w-10 h-10 rounded-xl flex-shrink-0" style="background:rgba(239,68,68,0.12)">
          <svg class="w-5 h-5" style="color:var(--brand)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M9 4v5M15 4v5"/></svg>
        </span>
        <div>
          <p class="text-sm font-semibold" style="color:var(--text)">Browse Movies</p>
          <p class="text-xs" style="color:var(--muted)">Explore the library</p>
        </div>
      </a>
    <% } %>
  </div>

  <!-- Logout -->
  <div class="mt-4">
    <a href="/logout" class="w-full flex items-center justify-center gap-2 py-3 rounded-2xl text-sm font-medium transition-all border"
      style="color:var(--brand);border-color:var(--border)"
      onmouseover="this.style.background='rgba(239,68,68,0.08)'" onmouseout="this.style.background='transparent'">
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>
      Logout
    </a>
  </div>

</section>

<%- include('partials/layout-close') %>
