<%- include('partials/layout-open') %>

<section class="max-w-md mx-auto px-4 pt-20 pb-10">
  <div class="glass rounded-3xl p-8 dark:border-white/10 border-slate-200">
    <div class="flex items-center gap-2 mb-6">
      <span class="grid place-items-center w-10 h-10 rounded-xl bg-gradient-to-br from-brand-500 to-red-700">
        <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm6 4v8l6-4-6-4z"/></svg>
      </span>
      <span class="font-display font-extrabold text-xl dark:text-white text-slate-900">Join <span class="text-brand-500">XP Movies</span></span>
    </div>

    <form action="/register" method="post" class="space-y-4" id="register-form">

      <!-- Role selector -->
      <div>
        <label class="text-sm dark:text-slate-300 text-slate-600 block mb-2">Account Type</label>
        <div class="grid grid-cols-2 gap-3">

          <!-- User card -->
          <label id="card-user" class="role-card cursor-pointer rounded-xl border-2 border-brand-500 bg-brand-500/10 p-3 flex flex-col gap-1 transition-all">
            <input type="radio" name="role" value="user" class="sr-only" checked />
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
              <span class="text-sm font-semibold dark:text-white text-slate-900">User</span>
            </span>
            <span class="text-xs dark:text-slate-400 text-slate-500">Browse, search &amp; view movies.</span>
          </label>

          <!-- Admin card -->
          <label id="card-admin" class="role-card cursor-pointer rounded-xl border-2 dark:border-white/10 border-slate-200 dark:bg-white/5 bg-slate-50 p-3 flex flex-col gap-1 transition-all">
            <input type="radio" name="role" value="admin" class="sr-only" />
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3 7h7l-5.5 4 2 7L12 17l-6.5 3 2-7L2 9h7z"/></svg>
              <span class="text-sm font-semibold dark:text-slate-300 text-slate-600">Admin</span>
            </span>
            <span class="text-xs dark:text-slate-500 text-slate-400">Full access. Requires secret key.</span>
          </label>

        </div>
      </div>

      <!-- Admin secret (hidden until Admin selected) -->
      <div id="admin-secret-field" class="hidden">
        <label class="text-sm dark:text-slate-300 text-slate-600">Admin Secret Key</label>
        <div class="relative mt-1">
          <input name="adminSecret" type="password" id="adminSecret" class="input w-full pr-10" placeholder="Enter admin secret" />
          <button type="button" onclick="toggleVisibility('adminSecret', 'eye-secret')" class="absolute inset-y-0 right-3 flex items-center text-slate-400 dark:hover:text-white hover:text-slate-700 transition-colors">
            <svg id="eye-secret" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
            </svg>
          </button>
        </div>
        <p class="text-xs text-slate-500 mt-1">Provided by the site owner.</p>
      </div>

      <div>
        <label class="text-sm dark:text-slate-300 text-slate-600">Name</label>
        <input name="name" required class="input mt-1 w-full" placeholder="Your name" />
      </div>
      <div>
        <label class="text-sm dark:text-slate-300 text-slate-600">Email</label>
        <input name="email" type="email" required class="input mt-1 w-full" placeholder="you@example.com" />
      </div>
      <div>
        <label class="text-sm dark:text-slate-300 text-slate-600">Password</label>
        <div class="relative mt-1">
          <input name="password" type="password" id="reg-password" required minlength="6" class="input w-full pr-10" placeholder="At least 6 characters" />
          <button type="button" onclick="toggleVisibility('reg-password', 'eye-reg-password')" class="absolute inset-y-0 right-3 flex items-center text-slate-400 dark:hover:text-white hover:text-slate-700 transition-colors">
            <svg id="eye-reg-password" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
            </svg>
          </button>
        </div>
      </div>

      <button class="btn-primary w-full justify-center" id="submit-btn">Create Account</button>
    </form>

    <p class="text-sm dark:text-slate-400 text-slate-500 mt-6 text-center">Already have an account? <a href="/login" class="text-brand-400 hover:text-brand-300">Sign in</a></p>
  </div>
</section>

<script>
  function toggleVisibility(inputId, iconId) {
    const input = document.getElementById(inputId);
    const icon = document.getElementById(iconId);
    const isHidden = input.type === 'password';
    input.type = isHidden ? 'text' : 'password';
    icon.innerHTML = isHidden
      ? '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/>'
      : '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
  }

  const radios = document.querySelectorAll('input[name="role"]');
  const cardUser = document.getElementById('card-user');
  const cardAdmin = document.getElementById('card-admin');
  const secretField = document.getElementById('admin-secret-field');
  const secretInput = document.getElementById('adminSecret');
  const submitBtn = document.getElementById('submit-btn');

  function updateUI() {
    const isAdmin = document.querySelector('input[name="role"]:checked').value === 'admin';

    cardUser.className = `role-card cursor-pointer rounded-xl border-2 p-3 flex flex-col gap-1 transition-all ${!isAdmin ? 'border-brand-500 bg-brand-500/10' : 'dark:border-white/10 border-slate-200 dark:bg-white/5 bg-slate-50'}`;
    cardAdmin.className = `role-card cursor-pointer rounded-xl border-2 p-3 flex flex-col gap-1 transition-all ${isAdmin ? 'border-brand-500 bg-brand-500/10' : 'dark:border-white/10 border-slate-200 dark:bg-white/5 bg-slate-50'}`;

    cardUser.querySelector('svg').className = `w-4 h-4 ${!isAdmin ? 'text-brand-400' : 'text-slate-400'}`;
    cardUser.querySelector('span.text-sm').className = `text-sm font-semibold ${!isAdmin ? 'dark:text-white text-slate-900' : 'dark:text-slate-300 text-slate-600'}`;
    cardAdmin.querySelector('svg').className = `w-4 h-4 ${isAdmin ? 'text-brand-400' : 'text-slate-400'}`;
    cardAdmin.querySelector('span.text-sm').className = `text-sm font-semibold ${isAdmin ? 'dark:text-white text-slate-900' : 'dark:text-slate-300 text-slate-600'}`;

    secretField.classList.toggle('hidden', !isAdmin);
    secretInput.required = isAdmin;
    submitBtn.textContent = isAdmin ? 'Create Admin Account' : 'Create Account';
  }

  radios.forEach(r => r.addEventListener('change', updateUI));
</script>

<%- include('partials/layout-close') %>
